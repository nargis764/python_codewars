def likes(names):
    # your code here
    resulted_string = ""
    if len(names) == 0:
        resulted_string = "no one likes this"
    elif len(names) == 1:
        resulted_string = f"{names[0]} likes this"
    elif len(names) == 2:  
        resulted_string = f"{names[0]} and {names[1]} like this"
    elif len(names) == 3:  
        resulted_string = f"{names[0]}, {names[1]} and {names[2]} like this"   
    elif len(names) > 3:  
        resulted_string = f"{names[0]}, {names[1]} and {len(names) - 2} others like this" 
    return resulted_string    
