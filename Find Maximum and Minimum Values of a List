def minimum(arr):
    #your code here...
    min = arr[0]
    
    for i in range(len(arr)):
        if arr[i] <= min:
            min = arr[i]
    return min       

def maximum(arr):
    #...and here
    max = arr[0]
    
    for i in range(len(arr)):
        if arr[i] >= max:
            max = arr[i]
    return max 
