def duplicate_count(text):
    # Your code goes here
    my_dict = {}
    text_counter = 0
    
    for s in text.lower():
        if s in my_dict:
            my_dict[s] += 1
        else:
            my_dict[s] = 1
            
    for i in list(my_dict):
        if my_dict[i] >= 2:
            text_counter += 1
            
    return text_counter        
    
     
